#!/usr/bin/env bash
# =============================================================================
# wg-delete-client
# WireGuard Manager — Permanently delete a VPN client
#
# - Removes the peer from the live WireGuard tunnel immediately
# - Removes the peer block from wg0.conf
# - Deletes all client keys and config files
# - Removes the client from the database
#
# This is PERMANENT. Use wg-disable-client if you only want to
# temporarily block access while keeping the client's keys and config.
#
# Usage:
#   wg-delete-client <name>
#   wg-delete-client            (interactive)
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Get client name ----
CLIENT_NAME="${1:-}"
if [[ -z "${CLIENT_NAME}" ]]; then
    read -rp "  Client name to delete: " CLIENT_NAME
fi

CLIENT_NAME="${CLIENT_NAME//[^a-zA-Z0-9_-]/}"

# ---- Verify client exists ----
if ! grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  Client '${CLIENT_NAME}' not found.${RESET}"
    echo -e "  Run ${CYAN}wg-list-clients${RESET} to see all clients."
    exit 1
fi

# ---- Warn and confirm ----
CLIENT_IP="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f2)"
echo ""
echo -e "  ${YELLOW}${BOLD}Warning: This will permanently delete client '${CLIENT_NAME}'.${RESET}"
echo -e "  VPN IP  : ${CLIENT_IP}"
echo -e "  This cannot be undone. The client will lose VPN access immediately."
echo ""
echo -e "  ${CYAN}Tip: Use 'wg-disable-client ${CLIENT_NAME}' to temporarily block"
echo -e "  access while keeping their config intact.${RESET}"
echo ""
read -rp "  Type the client name to confirm deletion [or press Enter to cancel]: " confirm

if [[ "${confirm}" != "${CLIENT_NAME}" ]]; then
    echo -e "\n  Cancelled — name did not match.\n"
    exit 0
fi

# ---- Get public key before we delete anything ----
CLIENT_PUBKEY="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f3)"

# ---- Remove peer from live WireGuard tunnel ----
if [[ -n "${CLIENT_PUBKEY}" ]]; then
    if wg show wg0 peers 2>/dev/null | grep -q "${CLIENT_PUBKEY}"; then
        wg set wg0 peer "${CLIENT_PUBKEY}" remove 2>/dev/null
        echo -e "  ${GREEN}✔${RESET} Peer removed from live tunnel."
    else
        echo -e "  ${YELLOW}  Peer was not active in tunnel (already disconnected or disabled).${RESET}"
    fi
fi

# ---- Remove peer block from wg0.conf ----
python3 - "${WG_CONF}" "${CLIENT_NAME}" <<'PYEOF'
import sys, re

conf_path   = sys.argv[1]
client_name = sys.argv[2]

with open(conf_path, 'r') as f:
    content = f.read()

# Match the comment header + full [Peer] block for this client.
# The #~ prefix (used by wg-disable-client) is handled by [^\[]* which
# matches any content until the next section header or end of file.
pattern = rf'\n# --- Client: {re.escape(client_name)} ---\n\[Peer\][^\[]*'
cleaned = re.sub(pattern, '', content)

with open(conf_path, 'w') as f:
    f.write(cleaned)

print(f"  Peer block for '{client_name}' removed from wg0.conf")
PYEOF

# ---- Delete client directory (keys + config) ----
CLIENT_DIR="${WGM_CLIENTS_DIR}/${CLIENT_NAME}"
if [[ -d "${CLIENT_DIR}" ]]; then
    rm -rf "${CLIENT_DIR}"
    echo -e "  ${GREEN}✔${RESET} Client files deleted: ${CLIENT_DIR}"
else
    echo -e "  ${YELLOW}  Client directory not found (${CLIENT_DIR}) — skipping.${RESET}"
fi

# ---- Remove from database ----
sed -i "/^${CLIENT_NAME}|/d" "${WGM_DB}"
echo -e "  ${GREEN}✔${RESET} Removed from client database."

echo ""
echo -e "${GREEN}  Client '${CLIENT_NAME}' has been permanently deleted.${RESET}"
echo ""
