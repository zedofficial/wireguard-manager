#!/usr/bin/env bash
# =============================================================================
# wg-regen-qr
# WireGuard Manager — Regenerate and display the QR code for a client
# Keys are NEVER changed. This just re-renders the QR from the existing config.
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Get client name ----
CLIENT_NAME="${1:-}"
if [[ -z "${CLIENT_NAME}" ]]; then
    read -rp "  Client name: " CLIENT_NAME
fi

CLIENT_NAME="${CLIENT_NAME//[^a-zA-Z0-9_-]/}"

# ---- Verify client exists ----
if ! grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  Client '${CLIENT_NAME}' not found.${RESET}"
    echo -e "  Run ${CYAN}wg-list-clients${RESET} to see all clients."
    exit 1
fi

# ---- Check status ----
CLIENT_STATUS="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f5)"
if [[ "${CLIENT_STATUS}" == "disabled" ]]; then
    echo -e "${YELLOW}  Note: Client '${CLIENT_NAME}' is currently disabled.${RESET}"
    echo -e "  The QR code is shown but the client cannot connect until re-enabled."
fi

# ---- Locate config ----
CONF_FILE="${WGM_CLIENTS_DIR}/${CLIENT_NAME}/${CLIENT_NAME}.conf"
if [[ ! -f "${CONF_FILE}" ]]; then
    echo -e "${RED}  Config file not found: ${CONF_FILE}${RESET}"
    echo -e "  The client record exists in the database but the config file is missing."
    echo -e "  You may need to delete and recreate this client."
    exit 1
fi

# ---- Display QR ----
echo -e "\n${CYAN}${BOLD}  QR Code for '${CLIENT_NAME}'${RESET}"
echo -e "  ${YELLOW}Scan this with the WireGuard app on iOS or Android.${RESET}\n"

qrencode -t ansiutf8 < "${CONF_FILE}"

echo ""
echo -e "  ${CYAN}Client IP :${RESET} $(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f2)"
echo -e "  ${CYAN}Endpoint  :${RESET} ${SERVER_ENDPOINT}:${WG_PORT}"
echo -e "  ${CYAN}Config    :${RESET} ${CONF_FILE}"
echo ""
echo -e "  ${GREEN}Keys are unchanged.${RESET} This is the same config the client already has."
echo ""
