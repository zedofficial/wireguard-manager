#!/usr/bin/env bash
# =============================================================================
# wg-update
# WireGuard Manager — Self-updater (tag-pinned + checksum-verified)
#
# Pulls the release from the immutable git tag v<version> (NOT the moving 'main'
# branch), stages every file, and verifies each against checksums.txt BEFORE
# touching anything on the system. A single bad hash aborts the whole update, so
# a corrupted, truncated, or tampered download can never leave a half-installed
# (broken) root system. Updates: wg-* commands, the PHP dashboard, the sudoers
# rules, reset.sh, and backup.sh.
#
# NEVER touches: wg0.conf, server/client keys, clients.db, config.env (except the
# WGM_VERSION line), dashboard.passwd, ddns/update.sh credentials, or backups/.
#
# Usage:
#   wg-update            — check and apply updates
#   wg-update --check    — check version only, don't update
#   wg-update --force    — reinstall even if already on the latest version
#   wg-update --yes      — non-interactive (used by the auto-update cron)
# =============================================================================
set -euo pipefail

# ---- Configuration ----
GITHUB_USER="zedofficial"
GITHUB_REPO="wireguard-manager"
GITHUB_BRANCH="main"
GITHUB_RAW="https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_REPO}/${GITHUB_BRANCH}"

WGM_DIR="/opt/wireguard"
BIN_DIR="/usr/local/bin"
DASHBOARD_DIR="/var/www/html/wireguard-manager"
WGM_LOG_DIR="/var/log/wireguard-manager"
VERSION_FILE="${WGM_DIR}/version"
BACKUP_DIR="${WGM_DIR}/backups/pre-update"

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Parse flags ----
CHECK_ONLY=false; FORCE_UPDATE=false; YES_MODE=false
for arg in "$@"; do
    case "${arg}" in
        --check) CHECK_ONLY=true ;;
        --force) FORCE_UPDATE=true ;;
        --yes)   YES_MODE=true ;;
    esac
done

[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [UPDATE] $*" >> "${WGM_LOG_DIR}/update.log" 2>/dev/null || true; }

echo -e "\n${CYAN}${BOLD}  WireGuard Manager — Updater${RESET}\n"

# ---- Current installed version ----
if [[ -f "${VERSION_FILE}" ]]; then
    CURRENT_VERSION="$(tr -d '[:space:]' < "${VERSION_FILE}")"
else
    CURRENT_VERSION="unknown"
fi
echo -e "  Installed version : ${CYAN}${CURRENT_VERSION}${RESET}"

# ---- Latest version (the 'main/version' pointer says what the newest release is) ----
echo -e "  Checking GitHub for updates..."
LATEST_VERSION="$(curl -sf --max-time 10 "${GITHUB_RAW}/version" 2>/dev/null | tr -d '[:space:]' || echo '')"
if [[ -z "${LATEST_VERSION}" ]]; then
    echo -e "${RED}  Could not reach GitHub. Check your internet connection.${RESET}"
    exit 1
fi
echo -e "  Latest version    : ${CYAN}${LATEST_VERSION}${RESET}"

if [[ "${CURRENT_VERSION}" == "${LATEST_VERSION}" && "${FORCE_UPDATE}" == false ]]; then
    echo -e "\n${GREEN}  You are up to date. (${CURRENT_VERSION})${RESET}\n"
    log "Already up to date: ${CURRENT_VERSION}"
    exit 0
fi

if [[ "${CHECK_ONLY}" == true ]]; then
    [[ "${CURRENT_VERSION}" != "${LATEST_VERSION}" ]] && {
        echo -e "\n${YELLOW}  Update available: ${CURRENT_VERSION} → ${LATEST_VERSION}${RESET}"
        echo -e "  Run ${CYAN}wg-update${RESET} to apply.\n"
    }
    exit 0
fi

# ---- Confirm ----
echo ""
if [[ "${FORCE_UPDATE}" == true && "${CURRENT_VERSION}" == "${LATEST_VERSION}" ]]; then
    echo -e "  ${YELLOW}Forcing reinstall of version ${LATEST_VERSION}${RESET}"
else
    echo -e "  ${YELLOW}Update available: ${CURRENT_VERSION} → ${LATEST_VERSION}${RESET}"
fi
if [[ "${YES_MODE}" == false ]]; then
    read -rp "  Apply update now? [Y/n]: " confirm
    [[ "${confirm}" =~ ^[Nn]$ ]] && { echo "  Update cancelled."; exit 0; }
else
    echo -e "  ${CYAN}Running non-interactively (--yes). Applying update...${RESET}"
fi
log "Starting update: ${CURRENT_VERSION} → ${LATEST_VERSION}"

# ---- Pre-update backup of the current scripts/dashboard ----
echo ""
echo -e "  ${CYAN}Creating pre-update backup...${RESET}"
mkdir -p "${BACKUP_DIR}"
BACKUP_FILE="${BACKUP_DIR}/pre_update_$(date '+%Y%m%d_%H%M%S').tar.gz"
tar -czf "${BACKUP_FILE}" "${BIN_DIR}"/wg-* "${WGM_DIR}/version" 2>/dev/null || true
[[ -d "${DASHBOARD_DIR}" ]] && tar -czf "${BACKUP_DIR}/dashboard_$(date '+%Y%m%d_%H%M%S').tar.gz" "${DASHBOARD_DIR}/" 2>/dev/null || true
echo -e "  ${GREEN}✔ Backup saved: ${BACKUP_FILE}${RESET}"
log "Pre-update backup: ${BACKUP_FILE}"

# =============================================================================
# Download from the release TAG, stage everything, verify all checksums, and only
# then deploy. Nothing on the system is touched until every file is verified.
# =============================================================================
TAG="v${LATEST_VERSION}"
TAG_RAW="https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_REPO}/${TAG}"

STAGE="$(mktemp -d)"
trap 'rm -rf "${STAGE}"' EXIT

fetch_tag() {   # <repo_path> -> stages to ${STAGE}/<repo_path>
    local rp="$1" dst="${STAGE}/$1"
    mkdir -p "$(dirname "${dst}")"
    curl -sf --max-time 30 -o "${dst}" "${TAG_RAW}/${rp}"
}

abort() {
    echo -e "\n${RED}  Update aborted: $*${RESET}"
    echo -e "  ${YELLOW}Nothing was changed — still on ${CURRENT_VERSION}.${RESET}\n"
    log "ABORTED: $*"
    exit 1
}

echo ""
echo -e "  ${CYAN}Fetching release ${TAG} and verifying checksums...${RESET}"

# checksums.txt is the trusted list of expected file hashes for this tag.
fetch_tag "checksums.txt" \
    || abort "could not fetch checksums.txt from ${TAG} — was ${LATEST_VERSION} published with tools/release.sh?"
CHECKSUMS="${STAGE}/checksums.txt"
[[ -s "${CHECKSUMS}" ]] || abort "checksums.txt is empty"

expected_sum() { awk -v f="$1" '$2==f {print $1; exit}' "${CHECKSUMS}"; }

stage_verify() {   # <repo_path> — download from tag + verify sha256, or abort
    local rp="$1" want got
    want="$(expected_sum "${rp}")"
    [[ -z "${want}" ]] && abort "no checksum listed for ${rp}"
    fetch_tag "${rp}" || abort "download failed: ${rp}"
    got="$(sha256sum "${STAGE}/${rp}" | awk '{print $1}')"
    [[ "${want}" == "${got}" ]] || abort "checksum mismatch for ${rp} (expected ${want}, got ${got})"
}

# manifest.txt tells us which files deploy where — verify it, then read it.
stage_verify "manifest.txt"
MANIFEST="${STAGE}/manifest.txt"

BIN_FILES=(); while read -r p; do [[ -n "$p" ]] && BIN_FILES+=("$p"); done < <(grep -E '^bin[[:space:]]' "${MANIFEST}" | awk '{print $2}')
WEB_FILES=(); while read -r p; do [[ -n "$p" ]] && WEB_FILES+=("$p"); done < <(grep -E '^web[[:space:]]' "${MANIFEST}" | awk '{print $2}')

# Verify EVERY file we intend to deploy before installing any of them.
for rp in "${BIN_FILES[@]}"; do stage_verify "${rp}"; done
stage_verify "reset.sh"
stage_verify "version"
if [[ -d "${DASHBOARD_DIR}" ]]; then
    for rp in "${WEB_FILES[@]}"; do stage_verify "${rp}"; done
    stage_verify "wireguard-manager.sudoers"
fi
[[ -f "${WGM_DIR}/backup.sh" ]] && stage_verify "scripts/backup.sh"

echo -e "  ${GREEN}✔ All files verified against checksums.txt${RESET}"

# ---- Everything verified — deploy from the staging tree (no more network) ----
echo ""
echo -e "  ${CYAN}Installing verified files...${RESET}"

UPDATED_SCRIPTS=0
for rp in "${BIN_FILES[@]}"; do
    install -m 0755 "${STAGE}/${rp}" "${BIN_DIR}/$(basename "${rp}")"
    (( UPDATED_SCRIPTS++ )) || true
done
echo -e "  ${GREEN}✔${RESET} ${UPDATED_SCRIPTS} commands"

install -m 0700 "${STAGE}/reset.sh" "${WGM_DIR}/reset.sh"

if [[ -d "${DASHBOARD_DIR}" ]]; then
    for rp in "${WEB_FILES[@]}"; do
        install -m 0644 "${STAGE}/${rp}" "${DASHBOARD_DIR}/$(basename "${rp}")"
    done
    # sudoers: already checksum-verified; re-validate with visudo as belt-and-suspenders.
    if visudo -cf "${STAGE}/wireguard-manager.sudoers" >/dev/null 2>&1; then
        install -m 0440 "${STAGE}/wireguard-manager.sudoers" /etc/sudoers.d/wireguard-manager
    fi
    systemctl reload apache2 2>/dev/null || true
    echo -e "  ${GREEN}✔${RESET} dashboard + sudo rules"
fi

[[ -f "${WGM_DIR}/backup.sh" ]] && install -m 0700 "${STAGE}/scripts/backup.sh" "${WGM_DIR}/backup.sh"

install -m 0644 "${STAGE}/version" "${VERSION_FILE}"
chown root:www-data "${VERSION_FILE}" 2>/dev/null || true

# Keep config.env's version snapshot in sync (install-time copy).
sed -i "s/^WGM_VERSION=.*/WGM_VERSION=\"${LATEST_VERSION}\"/" "${WGM_DIR}/config.env" 2>/dev/null || true

# Refresh the dashboard's update banner immediately.
[[ -x "${BIN_DIR}/wg-check-update" ]] && "${BIN_DIR}/wg-check-update" >/dev/null 2>&1 || true

echo ""
echo -e "${GREEN}${BOLD}  Update complete!${RESET}"
echo -e "  Version   : ${CYAN}${CURRENT_VERSION} → ${LATEST_VERSION}${RESET}  (verified tag ${TAG})"
echo -e "  Commands  : ${UPDATED_SCRIPTS} updated"
echo -e "  Backup    : ${BACKUP_FILE}"
echo ""
echo -e "  ${YELLOW}WireGuard is still running — no restart needed. Clients unaffected.${RESET}\n"
log "Update complete: ${CURRENT_VERSION} → ${LATEST_VERSION} (tag ${TAG}) | commands: ${UPDATED_SCRIPTS}"
