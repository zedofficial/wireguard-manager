#!/usr/bin/env bash
# =============================================================================
# wg-add-client
# WireGuard Manager — Create a new VPN client
#
# - Generates private key, public key, and preshared key
# - Auto-assigns the next available IP in the VPN subnet
# - Writes the client config to /etc/wireguard/clients/<name>/
# - Appends the peer block to wg0.conf
# - Adds the peer to the live tunnel (no restart needed)
# - Registers the client in the database
# - Displays a QR code for mobile onboarding
#
# Usage:
#   wg-add-client <name>
#   wg-add-client            (interactive)
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Get client name ----
CLIENT_NAME="${1:-}"
if [[ -z "${CLIENT_NAME}" ]]; then
    read -rp "  Client name (no spaces): " CLIENT_NAME
fi

# Sanitize: replace spaces with hyphens, strip anything else invalid
CLIENT_NAME="${CLIENT_NAME// /-}"
CLIENT_NAME="${CLIENT_NAME//[^a-zA-Z0-9_-]/}"

if [[ -z "${CLIENT_NAME}" ]]; then
    echo -e "${RED}  Invalid client name. Use letters, numbers, hyphens, underscores.${RESET}"
    exit 1
fi

# ---- Check for duplicate ----
if grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  Client '${CLIENT_NAME}' already exists.${RESET}"
    echo -e "  Use ${CYAN}wg-list-clients${RESET} to see existing clients."
    exit 1
fi

# ---- Find next available VPN IP ----
find_next_ip() {
    local base="${VPN_BASE_IP}"
    for i in $(seq 2 254); do
        local candidate="${base}.${i}"
        if ! grep -q "|${candidate}|" "${WGM_DB}" 2>/dev/null; then
            echo "${candidate}"
            return
        fi
    done
    echo ""
}

CLIENT_IP="$(find_next_ip)"
if [[ -z "${CLIENT_IP}" ]]; then
    echo -e "${RED}  No available IPs in subnet ${VPN_SUBNET}. Max 253 clients.${RESET}"
    exit 1
fi

# ---- Generate keys ----
echo -e "${CYAN}  Generating keys for '${CLIENT_NAME}'...${RESET}"
CLIENT_PRIVATE_KEY="$(wg genkey)"
CLIENT_PUBLIC_KEY="$(echo "${CLIENT_PRIVATE_KEY}" | wg pubkey)"
CLIENT_PRESHARED_KEY="$(wg genpsk)"

# ---- Save client key files ----
CLIENT_DIR="${WGM_CLIENTS_DIR}/${CLIENT_NAME}"
mkdir -p "${CLIENT_DIR}"
chmod 700 "${CLIENT_DIR}"

echo "${CLIENT_PRIVATE_KEY}"   > "${CLIENT_DIR}/private.key"
echo "${CLIENT_PUBLIC_KEY}"    > "${CLIENT_DIR}/public.key"
echo "${CLIENT_PRESHARED_KEY}" > "${CLIENT_DIR}/preshared.key"
chmod 600 "${CLIENT_DIR}/private.key"
chmod 600 "${CLIENT_DIR}/preshared.key"
chmod 644 "${CLIENT_DIR}/public.key"

# ---- Generate client .conf file ----
SERVER_PUBLIC_KEY="$(cat /etc/wireguard/server_public.key)"
CLIENT_CONF="${CLIENT_DIR}/${CLIENT_NAME}.conf"

cat > "${CLIENT_CONF}" <<EOF
# WireGuard Client Config — ${CLIENT_NAME}
# Generated by WireGuard Manager
# Server endpoint: ${SERVER_ENDPOINT}:${WG_PORT}

[Interface]
Address    = ${CLIENT_IP}/32
PrivateKey = ${CLIENT_PRIVATE_KEY}
DNS        = ${CLIENT_DNS}

[Peer]
PublicKey           = ${SERVER_PUBLIC_KEY}
PresharedKey        = ${CLIENT_PRESHARED_KEY}
Endpoint            = ${SERVER_ENDPOINT}:${WG_PORT}
AllowedIPs          = 0.0.0.0/0
PersistentKeepalive = 25
EOF
chmod 600 "${CLIENT_CONF}"

# ---- Append peer block to wg0.conf ----
cat >> "${WG_CONF}" <<EOF

# --- Client: ${CLIENT_NAME} ---
[Peer]
PublicKey    = ${CLIENT_PUBLIC_KEY}
PresharedKey = ${CLIENT_PRESHARED_KEY}
AllowedIPs   = ${CLIENT_IP}/32
EOF

# ---- Add peer to live tunnel (no restart needed) ----
wg addconf wg0 <(
    echo "[Peer]"
    echo "PublicKey    = ${CLIENT_PUBLIC_KEY}"
    echo "PresharedKey = ${CLIENT_PRESHARED_KEY}"
    echo "AllowedIPs   = ${CLIENT_IP}/32"
) 2>/dev/null || systemctl reload wg-quick@wg0 2>/dev/null || true

# ---- Register in database ----
echo "${CLIENT_NAME}|${CLIENT_IP}|${CLIENT_PUBLIC_KEY}|$(date '+%Y-%m-%d %H:%M:%S')|active" >> "${WGM_DB}"

# ---- Output ----
echo ""
echo -e "${GREEN}  ✔ Client '${CLIENT_NAME}' created.${RESET}"
echo -e "  VPN IP  : ${CYAN}${CLIENT_IP}${RESET}"
echo -e "  Config  : ${CYAN}${CLIENT_CONF}${RESET}"
echo ""
echo -e "${YELLOW}  QR Code — scan with the WireGuard app (iOS / Android):${RESET}"
echo ""
qrencode -t ansiutf8 < "${CLIENT_CONF}"
echo ""
echo -e "  Or download the config file and import it manually."
echo -e "  Use ${CYAN}wg-export-client ${CLIENT_NAME} --path /tmp${RESET} to save a copy elsewhere."
echo ""
