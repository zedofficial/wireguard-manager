#!/usr/bin/env bash
# =============================================================================
# wg-export-client
# WireGuard Manager — Export a client config (.conf file, QR, or both)
# Usage:
#   wg-export-client <name>              — prints QR + saves .conf to CWD
#   wg-export-client <name> --conf       — prints raw config only
#   wg-export-client <name> --qr         — prints QR only
#   wg-export-client <name> --path /tmp  — saves .conf to specified directory
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Usage ----
usage() {
    echo -e "\n${BOLD}  Usage:${RESET}"
    echo -e "  wg-export-client <name>              — QR code + save .conf to current dir"
    echo -e "  wg-export-client <name> --conf       — Print raw config to terminal"
    echo -e "  wg-export-client <name> --qr         — Print QR code only"
    echo -e "  wg-export-client <name> --path /dir  — Save .conf to specified directory"
    echo ""
    exit 1
}

# ---- Parse args ----
CLIENT_NAME="${1:-}"
[[ -z "${CLIENT_NAME}" ]] && usage

MODE="both"       # default: QR + save conf
EXPORT_PATH="$(pwd)"

shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --conf)   MODE="conf" ;;
        --qr)     MODE="qr" ;;
        --path)
            shift
            EXPORT_PATH="${1:-}"
            [[ -z "${EXPORT_PATH}" ]] && { echo -e "${RED}  --path requires a directory.${RESET}"; exit 1; }
            MODE="save"
            ;;
        *) echo -e "${RED}  Unknown option: $1${RESET}"; usage ;;
    esac
    shift
done

# ---- Sanitize name ----
CLIENT_NAME="${CLIENT_NAME//[^a-zA-Z0-9_-]/}"

# ---- Verify client exists ----
if ! grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  Client '${CLIENT_NAME}' not found.${RESET}"
    echo -e "  Run ${CYAN}wg-list-clients${RESET} to see all clients."
    exit 1
fi

# ---- Check status ----
CLIENT_STATUS="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f5)"
if [[ "${CLIENT_STATUS}" == "disabled" ]]; then
    echo -e "${YELLOW}  Warning: Client '${CLIENT_NAME}' is currently disabled.${RESET}"
    echo -e "  Re-enable with: ${CYAN}wg-enable-client ${CLIENT_NAME}${RESET}"
fi

# ---- Locate config file ----
CONF_FILE="${WGM_CLIENTS_DIR}/${CLIENT_NAME}/${CLIENT_NAME}.conf"
if [[ ! -f "${CONF_FILE}" ]]; then
    echo -e "${RED}  Config file not found: ${CONF_FILE}${RESET}"
    echo -e "  The client may need to be recreated with ${CYAN}wg-add-client${RESET}."
    exit 1
fi

# ---- Execute based on mode ----
case "${MODE}" in
    conf)
        echo -e "\n${CYAN}  Config for '${CLIENT_NAME}':${RESET}\n"
        cat "${CONF_FILE}"
        echo ""
        ;;
    qr)
        echo -e "\n${CYAN}  QR Code for '${CLIENT_NAME}' (scan with WireGuard app):${RESET}\n"
        qrencode -t ansiutf8 < "${CONF_FILE}"
        echo ""
        ;;
    save)
        # Validate export path
        if [[ ! -d "${EXPORT_PATH}" ]]; then
            mkdir -p "${EXPORT_PATH}" || {
                echo -e "${RED}  Cannot create directory: ${EXPORT_PATH}${RESET}"
                exit 1
            }
        fi
        DEST="${EXPORT_PATH}/${CLIENT_NAME}.conf"
        cp "${CONF_FILE}" "${DEST}"
        chmod 600 "${DEST}"
        echo -e "${GREEN}  Config saved to: ${DEST}${RESET}"
        ;;
    both)
        # QR + save to current directory
        echo -e "\n${CYAN}  QR Code for '${CLIENT_NAME}' (scan with WireGuard app):${RESET}\n"
        qrencode -t ansiutf8 < "${CONF_FILE}"
        echo ""

        DEST="${EXPORT_PATH}/${CLIENT_NAME}.conf"
        cp "${CONF_FILE}" "${DEST}"
        chmod 600 "${DEST}"
        echo -e "${GREEN}  Config also saved to: ${DEST}${RESET}"
        echo -e "  Share the .conf file via a secure channel (Signal, encrypted email, etc.)"
        echo ""
        ;;
esac
