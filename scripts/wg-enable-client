#!/usr/bin/env bash
# =============================================================================
# wg-enable-client
# WireGuard Manager — Re-enable a previously disabled client
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Get client name ----
CLIENT_NAME="${1:-}"
if [[ -z "${CLIENT_NAME}" ]]; then
    read -rp "  Client name to enable: " CLIENT_NAME
fi

CLIENT_NAME="${CLIENT_NAME// /-}"

# ---- Verify client exists in DB ----
if ! grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  Client '${CLIENT_NAME}' not found.${RESET}"
    echo -e "  Run ${CYAN}wg-list-clients${RESET} to see all clients."
    exit 1
fi

# ---- Check if actually disabled ----
CURRENT_STATUS="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f5)"
if [[ "${CURRENT_STATUS}" == "active" ]]; then
    echo -e "${YELLOW}  Client '${CLIENT_NAME}' is already active.${RESET}"
    exit 0
fi

# ---- Restore peer block in wg0.conf ----
python3 - "${WG_CONF}" "${CLIENT_NAME}" <<'PYEOF'
import sys, re

conf_path   = sys.argv[1]
client_name = sys.argv[2]

with open(conf_path, 'r') as f:
    content = f.read()

# Find the peer block for this client and remove the #~ prefixes
pattern = rf'(\n# --- Client: {re.escape(client_name)} ---\n\[Peer\][^\[]*)'

def enable_block(m):
    block = m.group(1)
    lines = block.split('\n')
    new_lines = []
    for line in lines:
        # Remove the #~ disable marker we added
        if line.startswith('#~'):
            new_lines.append(line[2:])
        else:
            new_lines.append(line)
    return '\n'.join(new_lines)

new_content = re.sub(pattern, enable_block, content)

with open(conf_path, 'w') as f:
    f.write(new_content)

print(f"  Peer block for '{client_name}' restored in wg0.conf")
PYEOF

# ---- Update database status ----
python3 - "${WGM_DB}" "${CLIENT_NAME}" "active" <<'PYEOF'
import sys

db_path     = sys.argv[1]
client_name = sys.argv[2]
new_status  = sys.argv[3]

lines = []
with open(db_path, 'r') as f:
    for line in f:
        stripped = line.rstrip('\n')
        if stripped.startswith(client_name + '|'):
            parts = stripped.split('|')
            if len(parts) >= 5:
                parts[4] = new_status
            lines.append('|'.join(parts))
        else:
            lines.append(stripped)

with open(db_path, 'w') as f:
    f.write('\n'.join(lines) + '\n')
PYEOF

# ---- Re-add peer to live WireGuard without restart ----
CLIENT_PUBKEY="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f3)"
CLIENT_IP="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f2)"
PRESHARED_KEY_FILE="${WGM_CLIENTS_DIR}/${CLIENT_NAME}/preshared.key"

if [[ -f "${PRESHARED_KEY_FILE}" ]]; then
    wg set wg0 peer "${CLIENT_PUBKEY}" \
        preshared-key "${PRESHARED_KEY_FILE}" \
        allowed-ips "${CLIENT_IP}/32" 2>/dev/null
else
    wg set wg0 peer "${CLIENT_PUBKEY}" \
        allowed-ips "${CLIENT_IP}/32" 2>/dev/null
fi

chown root:www-data "${WGM_DB}" 2>/dev/null || true
chmod 640 "${WGM_DB}" 2>/dev/null || true
echo -e "${GREEN}  Client '${CLIENT_NAME}' enabled and active.${RESET}"
echo -e "  They can now connect immediately (no restart needed)."
