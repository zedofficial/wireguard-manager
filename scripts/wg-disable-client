#!/usr/bin/env bash
# =============================================================================
# wg-disable-client
# WireGuard Manager — Disable a client (keeps keys/config, removes from tunnel)
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

# Serialize client-DB writes (flock) to avoid corruption from concurrent edits.
exec 200>"${WGM_DB}.lock" 2>/dev/null && flock -w 10 -x 200 2>/dev/null || true

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Get client name ----
CLIENT_NAME="${1:-}"
if [[ -z "${CLIENT_NAME}" ]]; then
    read -rp "  Client name to disable: " CLIENT_NAME
fi

CLIENT_NAME="${CLIENT_NAME// /-}"

# ---- Verify client exists ----
if ! grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  Client '${CLIENT_NAME}' not found.${RESET}"
    echo -e "  Run ${CYAN}wg-list-clients${RESET} to see all clients."
    exit 1
fi

# ---- Check if already disabled ----
CURRENT_STATUS="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f5)"
if [[ "${CURRENT_STATUS}" == "disabled" ]]; then
    echo -e "${YELLOW}  Client '${CLIENT_NAME}' is already disabled.${RESET}"
    exit 0
fi

# ---- Get public key ----
CLIENT_PUBKEY="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f3)"

# ---- Remove peer from live WireGuard (no restart needed) ----
if wg show wg0 peers 2>/dev/null | grep -q "${CLIENT_PUBKEY}"; then
    wg set wg0 peer "${CLIENT_PUBKEY}" remove 2>/dev/null
    echo -e "${CYAN}  Peer removed from live tunnel.${RESET}"
fi

# ---- Comment out peer block in wg0.conf using Python ----
python3 - "${WG_CONF}" "${CLIENT_NAME}" <<'PYEOF'
import sys, re

conf_path  = sys.argv[1]
client_name = sys.argv[2]

with open(conf_path, 'r') as f:
    content = f.read()

# Wrap the peer block with a DISABLED marker instead of deleting it
pattern = rf'(\n# --- Client: {re.escape(client_name)} ---\n\[Peer\][^\[]*)'

def disable_block(m):
    block = m.group(1)
    # Already disabled guard
    if '# DISABLED' in block:
        return block
    # Prefix every functional line with #~ to mark as disabled
    lines = block.split('\n')
    new_lines = []
    for line in lines:
        stripped = line.strip()
        if stripped.startswith('[') or stripped.startswith('#') or stripped == '':
            new_lines.append(line)
        else:
            new_lines.append('#~' + line)
    return '\n'.join(new_lines)

new_content = re.sub(pattern, disable_block, content)

with open(conf_path, 'w') as f:
    f.write(new_content)

print(f"  Peer block for '{client_name}' marked disabled in wg0.conf")
PYEOF

# ---- Update database status ----
# Use Python for safe in-place edit of the TSV line
python3 - "${WGM_DB}" "${CLIENT_NAME}" "disabled" <<'PYEOF'
import sys

db_path     = sys.argv[1]
client_name = sys.argv[2]
new_status  = sys.argv[3]

lines = []
with open(db_path, 'r') as f:
    for line in f:
        stripped = line.rstrip('\n')
        if stripped.startswith(client_name + '|'):
            parts = stripped.split('|')
            if len(parts) >= 5:
                parts[4] = new_status
            lines.append('|'.join(parts))
        else:
            lines.append(stripped)

with open(db_path, 'w') as f:
    f.write('\n'.join(lines) + '\n')
PYEOF

chown root:www-data "${WGM_DB}" 2>/dev/null || true
chmod 640 "${WGM_DB}" 2>/dev/null || true
echo -e "${GREEN}  Client '${CLIENT_NAME}' disabled.${RESET}"
echo -e "  They will not be able to connect until re-enabled."
echo -e "  Re-enable with: ${CYAN}wg-enable-client ${CLIENT_NAME}${RESET}"
