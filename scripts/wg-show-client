#!/usr/bin/env bash
# =============================================================================
# wg-show-client
# WireGuard Manager — Show a client's config and QR code
#
# Displays:
#   - The full client .conf file
#   - A scannable QR code for mobile onboarding
#   - Last handshake time (if the client has ever connected)
#   - Transfer stats for this peer
#
# Usage:
#   wg-show-client <name>
#   wg-show-client            (interactive)
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Get client name ----
CLIENT_NAME="${1:-}"
if [[ -z "${CLIENT_NAME}" ]]; then
    read -rp "  Client name: " CLIENT_NAME
fi

CLIENT_NAME="${CLIENT_NAME//[^a-zA-Z0-9_-]/}"

# ---- Verify client exists in DB ----
if ! grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  Client '${CLIENT_NAME}' not found.${RESET}"
    echo -e "  Run ${CYAN}wg-list-clients${RESET} to see all clients."
    exit 1
fi

# ---- Locate config file ----
CLIENT_CONF="${WGM_CLIENTS_DIR}/${CLIENT_NAME}/${CLIENT_NAME}.conf"
if [[ ! -f "${CLIENT_CONF}" ]]; then
    echo -e "${RED}  Config file missing: ${CLIENT_CONF}${RESET}"
    echo -e "  The database entry exists but the config file was not found."
    echo -e "  The client may need to be deleted and recreated."
    exit 1
fi

# ---- Get DB fields ----
CLIENT_IP="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f2)"
CLIENT_PUBKEY="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f3)"
CLIENT_CREATED="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f4)"
CLIENT_STATUS="$(grep "^${CLIENT_NAME}|" "${WGM_DB}" | cut -d'|' -f5)"

# ---- Header ----
echo ""
echo -e "${CYAN}${BOLD}  ── Client: ${CLIENT_NAME} ──────────────────────────────────${RESET}"
echo -e "  VPN IP   : ${CLIENT_IP}"
echo -e "  Created  : ${CLIENT_CREATED}"
echo -e "  Status   : $([ "${CLIENT_STATUS}" = "active" ] && echo "${GREEN}active${RESET}" || echo "${RED}${CLIENT_STATUS}${RESET}")"
echo -e "  Endpoint : ${SERVER_ENDPOINT}:${WG_PORT}"

# ---- Live tunnel stats ----
echo ""
if wg show wg0 &>/dev/null; then
    # Last handshake
    HANDSHAKE="$(wg show wg0 latest-handshakes 2>/dev/null | grep "^${CLIENT_PUBKEY}" | awk '{print $2}' || echo '0')"
    if [[ -n "${HANDSHAKE}" && "${HANDSHAKE}" != "0" ]]; then
        HS_HUMAN="$(date -d "@${HANDSHAKE}" 2>/dev/null || date -r "${HANDSHAKE}" 2>/dev/null || echo 'unknown')"
        echo -e "  Last handshake : ${GREEN}${HS_HUMAN}${RESET}"
    else
        echo -e "  Last handshake : ${YELLOW}Never (client has not connected yet)${RESET}"
    fi

    # Transfer stats
    TRANSFER="$(wg show wg0 transfer 2>/dev/null | grep "^${CLIENT_PUBKEY}" || echo '')"
    if [[ -n "${TRANSFER}" ]]; then
        RX="$(echo "${TRANSFER}" | awk '{print $2}')"
        TX="$(echo "${TRANSFER}" | awk '{print $3}')"
        echo -e "  Transfer       : ↓ ${RX} bytes received  ↑ ${TX} bytes sent"
    fi
else
    echo -e "  ${YELLOW}WireGuard interface wg0 is not running — cannot show live stats.${RESET}"
fi

# ---- Config file ----
echo ""
echo -e "${CYAN}${BOLD}  ── Config File ────────────────────────────────────────${RESET}"
echo ""
cat "${CLIENT_CONF}"
echo ""

# ---- QR code ----
echo -e "${YELLOW}${BOLD}  ── QR Code (scan with WireGuard app) ──────────────────${RESET}"
echo ""
qrencode -t ansiutf8 < "${CLIENT_CONF}"
echo ""
echo -e "  Config path : ${CYAN}${CLIENT_CONF}${RESET}"
echo -e "  Export copy : ${CYAN}wg-export-client ${CLIENT_NAME} --path /tmp${RESET}"
echo ""
