#!/usr/bin/env bash
# =============================================================================
# wg-import-client
# WireGuard Manager — Import an existing WireGuard client config into the manager
#
# Use case: You have clients that were added manually or from another system
# and want to bring them under WireGuard Manager's tracking.
#
# Usage:
#   wg-import-client <name> <path-to-client.conf>
#   wg-import-client                               (interactive)
# =============================================================================
set -euo pipefail

source /opt/wireguard/config.env

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root.${RESET}"; exit 1; }

# ---- Get args or prompt ----
CLIENT_NAME="${1:-}"
CONF_SOURCE="${2:-}"

if [[ -z "${CLIENT_NAME}" ]]; then
    read -rp "  Name for this imported client: " CLIENT_NAME
fi

CLIENT_NAME="${CLIENT_NAME// /-}"
CLIENT_NAME="${CLIENT_NAME//[^a-zA-Z0-9_-]/}"

if [[ -z "${CLIENT_NAME}" ]]; then
    echo -e "${RED}  Invalid client name.${RESET}"; exit 1
fi

if [[ -z "${CONF_SOURCE}" ]]; then
    read -rp "  Path to existing client .conf file: " CONF_SOURCE
fi

# ---- Validate source file ----
if [[ ! -f "${CONF_SOURCE}" ]]; then
    echo -e "${RED}  File not found: ${CONF_SOURCE}${RESET}"; exit 1
fi

# ---- Check for duplicate name ----
if grep -q "^${CLIENT_NAME}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  A client named '${CLIENT_NAME}' already exists.${RESET}"
    echo -e "  Choose a different name or delete the existing one first."
    exit 1
fi

echo -e "${CYAN}  Parsing config file...${RESET}"

# ---- Extract fields from the .conf file using Python ----
PARSE_RESULT="$(python3 - "${CONF_SOURCE}" <<'PYEOF'
import sys, re, configparser

conf_path = sys.argv[1]

# WireGuard conf files use [Section] headers — parse manually
# since configparser doesn't handle duplicate keys well
with open(conf_path, 'r') as f:
    content = f.read()

def extract(section, key):
    pattern = rf'\[{section}\].*?^{key}\s*=\s*(.+?)$'
    m = re.search(pattern, content, re.MULTILINE | re.DOTALL)
    return m.group(1).strip() if m else ''

client_priv = extract('Interface', 'PrivateKey')
client_addr = extract('Interface', 'Address')
client_dns  = extract('Interface', 'DNS')
server_pub  = extract('Peer', 'PublicKey')
preshared   = extract('Peer', 'PresharedKey')
endpoint    = extract('Peer', 'Endpoint')

# Derive public key from private key if possible
import subprocess
client_pub = ''
if client_priv:
    try:
        result = subprocess.run(['wg', 'pubkey'], input=client_priv.encode(),
                                capture_output=True)
        client_pub = result.stdout.decode().strip()
    except Exception:
        pass

# Extract IP from Address (strip CIDR)
client_ip = client_addr.split('/')[0] if client_addr else ''

print(f"CLIENT_PRIVATE_KEY={client_priv}")
print(f"CLIENT_PUBLIC_KEY={client_pub}")
print(f"CLIENT_IP={client_ip}")
print(f"CLIENT_DNS={client_dns}")
print(f"PRESHARED_KEY={preshared}")
print(f"SERVER_PUBKEY_IN_CONF={server_pub}")
print(f"ENDPOINT_IN_CONF={endpoint}")
PYEOF
)"

# Source the parsed values
eval "${PARSE_RESULT}"

# ---- Validate extracted fields ----
if [[ -z "${CLIENT_PUBLIC_KEY}" ]]; then
    echo -e "${RED}  Could not extract client public key from config.${RESET}"
    echo -e "  Make sure the file contains a valid [Interface] PrivateKey."
    exit 1
fi

if [[ -z "${CLIENT_IP}" ]]; then
    echo -e "${RED}  Could not extract client IP from config.${RESET}"
    exit 1
fi

# ---- Warn if endpoint doesn't match current server ----
CURRENT_ENDPOINT="${SERVER_ENDPOINT}:${WG_PORT}"
if [[ -n "${ENDPOINT_IN_CONF}" && "${ENDPOINT_IN_CONF}" != "${CURRENT_ENDPOINT}" ]]; then
    echo -e "${YELLOW}  Warning: Config endpoint (${ENDPOINT_IN_CONF}) differs from"
    echo -e "  current server (${CURRENT_ENDPOINT}).${RESET}"
    read -rp "  Import anyway? [y/N]: " proceed
    [[ ! "${proceed}" =~ ^[Yy]$ ]] && { echo "  Cancelled."; exit 0; }
fi

# ---- Check IP not already in use ----
if grep -q "|${CLIENT_IP}|" "${WGM_DB}" 2>/dev/null; then
    echo -e "${RED}  IP ${CLIENT_IP} is already assigned to another client.${RESET}"
    exit 1
fi

# ---- Copy config into managed location ----
CLIENT_DIR="${WGM_CLIENTS_DIR}/${CLIENT_NAME}"
mkdir -p "${CLIENT_DIR}"
chmod 700 "${CLIENT_DIR}"

cp "${CONF_SOURCE}" "${CLIENT_DIR}/${CLIENT_NAME}.conf"
chmod 600 "${CLIENT_DIR}/${CLIENT_NAME}.conf"

# Save extracted keys
[[ -n "${CLIENT_PRIVATE_KEY}" ]] && {
    echo "${CLIENT_PRIVATE_KEY}" > "${CLIENT_DIR}/private.key"
    chmod 600 "${CLIENT_DIR}/private.key"
}
echo "${CLIENT_PUBLIC_KEY}" > "${CLIENT_DIR}/public.key"
[[ -n "${PRESHARED_KEY}" ]] && {
    echo "${PRESHARED_KEY}" > "${CLIENT_DIR}/preshared.key"
    chmod 600 "${CLIENT_DIR}/preshared.key"
}

# ---- Add peer to wg0.conf if not already present ----
if ! grep -q "${CLIENT_PUBLIC_KEY}" "${WG_CONF}" 2>/dev/null; then
    cat >> "${WG_CONF}" <<EOF

# --- Client: ${CLIENT_NAME} ---
[Peer]
PublicKey    = ${CLIENT_PUBLIC_KEY}
$([ -n "${PRESHARED_KEY}" ] && echo "PresharedKey = ${PRESHARED_KEY}")
AllowedIPs   = ${CLIENT_IP}/32
EOF
    echo -e "  ${GREEN}✔${RESET} Peer block added to wg0.conf."
else
    echo -e "  ${YELLOW}Peer already exists in wg0.conf — skipping block addition.${RESET}"
fi

# ---- Add to live WireGuard tunnel ----
if [[ -n "${PRESHARED_KEY}" ]]; then
    wg set wg0 peer "${CLIENT_PUBLIC_KEY}" \
        preshared-key "${CLIENT_DIR}/preshared.key" \
        allowed-ips "${CLIENT_IP}/32" 2>/dev/null || true
else
    wg set wg0 peer "${CLIENT_PUBLIC_KEY}" \
        allowed-ips "${CLIENT_IP}/32" 2>/dev/null || true
fi

# ---- Register in database ----
echo "${CLIENT_NAME}|${CLIENT_IP}|${CLIENT_PUBLIC_KEY}|$(date '+%Y-%m-%d %H:%M:%S')|active" >> "${WGM_DB}"

echo ""
echo -e "${GREEN}  Client '${CLIENT_NAME}' imported successfully.${RESET}"
echo -e "  VPN IP     : ${CYAN}${CLIENT_IP}${RESET}"
echo -e "  Public key : ${CYAN}${CLIENT_PUBLIC_KEY}${RESET}"
echo -e "  Config     : ${CYAN}${CLIENT_DIR}/${CLIENT_NAME}.conf${RESET}"
echo ""
