#!/usr/bin/env bash
# =============================================================================
# wg-dashboard-passwd
# WireGuard Manager — Change the web dashboard password
#
# Prompts for a new password, hashes it with bcrypt via PHP,
# and writes it to /opt/wireguard/dashboard.passwd.
#
# Usage:
#   sudo wg-dashboard-passwd            (interactive — prompts for the new password)
#   echo 'newpass' | sudo wg-dashboard-passwd --stdin   (non-interactive; used by the
#                                                         dashboard's change-password page)
# =============================================================================
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

PASSWD_FILE="/opt/wireguard/dashboard.passwd"

# ---- Root check ----
[[ "$EUID" -ne 0 ]] && { echo -e "${RED}  Run as root: sudo wg-dashboard-passwd${RESET}"; exit 1; }

# ---- Check PHP is available ----
if ! command -v php &>/dev/null; then
    echo -e "${RED}  PHP is not installed. The dashboard requires PHP to hash passwords.${RESET}"
    exit 1
fi

# Hash a password with bcrypt. Pass via env var (not argv/inline) so special
# characters can't break the PHP source or leak through the process list.
hash_password() {
    WGM_NEWPASS="$1" php -r 'echo password_hash(getenv("WGM_NEWPASS"), PASSWORD_DEFAULT);'
}

write_password() {
    local hash="$1"
    [[ -z "${hash}" ]] && return 1
    echo "${hash}" > "${PASSWD_FILE}"
    chown root:www-data "${PASSWD_FILE}" 2>/dev/null || true
    chmod 640 "${PASSWD_FILE}"
}

# ---- Non-interactive mode: read one line from stdin (used by the dashboard) ----
if [[ "${1:-}" == "--stdin" ]]; then
    IFS= read -r newpass || true
    if [[ -z "${newpass}" ]]; then
        echo "ERROR: empty password"; exit 1
    fi
    if [[ "${#newpass}" -lt 6 ]]; then
        echo "ERROR: password must be at least 6 characters"; exit 1
    fi
    if [[ "${newpass}" == "admin" ]]; then
        echo "ERROR: password cannot be 'admin'"; exit 1
    fi
    if write_password "$(hash_password "${newpass}")"; then
        echo "OK"; exit 0
    fi
    echo "ERROR: failed to write password"; exit 1
fi

echo ""
echo -e "${CYAN}${BOLD}  WireGuard Manager — Dashboard Password${RESET}"
echo -e "  ─────────────────────────────────────────"
echo ""

# ---- Prompt for new password ----
read -rsp "  New password     : " p1; echo ""
read -rsp "  Confirm password : " p2; echo ""

if [[ -z "${p1}" ]]; then
    echo -e "\n${RED}  Password cannot be empty.${RESET}\n"
    exit 1
fi

if [[ "${p1}" != "${p2}" ]]; then
    echo -e "\n${RED}  Passwords do not match.${RESET}\n"
    exit 1
fi

if [[ "${#p1}" -lt 6 ]]; then
    echo -e "\n${YELLOW}  Warning: Password is very short (less than 6 characters).${RESET}"
    read -rp "  Continue anyway? [y/N]: " confirm
    [[ ! "${confirm}" =~ ^[Yy]$ ]] && { echo "  Cancelled."; exit 0; }
fi

# ---- Hash with bcrypt via PHP and write ----
if ! write_password "$(hash_password "${p1}")"; then
    echo -e "\n${RED}  Failed to generate or write password hash.${RESET}\n"
    exit 1
fi

echo ""
echo -e "${GREEN}  ✔ Dashboard password updated.${RESET}"
echo -e "  The new password takes effect immediately."
echo -e "  No service restart needed.\n"
